{ "$schema": "http://json-schema.org/draft-07/schema#", "title": "Measure & compare",
  "type": "object", "required": ["signal"], "additionalProperties": false, "properties": {
    "signal": { "type": "string", "title": "Signal to read" },
    "name": { "type": "string", "title": "Measurement name" },
    "unit": { "type": "string", "title": "Unit" },
    "min": { "type": "number", "title": "Min limit" },
    "max": { "type": "number", "title": "Max limit" },
    "expected": { "title": "Expected (exact match)" },
    "retries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 0, "title": "Re-read attempts on a failed/out-of-limit read" },
    "settle_s": { "type": "number", "minimum": 0, "default": 0.5, "title": "Pause between re-reads (s)" } } }
