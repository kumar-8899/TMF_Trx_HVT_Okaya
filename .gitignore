**/keystation_core.dll
backend/data/relaunch.json
backend/data/launcher.log

# local dev signing keys (never commit)
.secrets/

# tmf-debug captures + digests pulled from benches (REMOTE_DEBUG.md §8)
.debug/

# Nuitka crash report (build junk)
nuitka-crash-report.xml
