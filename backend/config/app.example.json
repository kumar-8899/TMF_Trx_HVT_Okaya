{
  "schema_version": 1,
  "station": "st1",
  "license": "config/license.json",
  "modules": [
    { "id": "hello", "variant": "default" },
    { "id": "daq",   "variant": "default" },
    {
      "id": "runs",
      "variant": "default",
      "config": {
        "acquisition": { "default_mode": "barcode", "barcode": { "strategy": "prefix", "length": 3 } }
      }
    },
    {
      "id": "auth",
      "variant": "local_db",
      "config": {
        "authenticator": "password",
        "session_ttl_min": 480,
        "password_policy": { "min_length": 5 },
        "roles": {
          "super_admin": ["AUTH.*", "TEST.*", "RECIPE.*", "REPORT.*", "MAINTENANCE.*", "SYSTEM.*", "ADMIN.*", "DIAGNOSTICS.*"],
          "admin": ["AUTH.MANAGE_USERS", "TEST.RUN", "RECIPE.VIEW", "RECIPE.EDIT", "REPORT.VIEW", "REPORT.EXPORT", "DIAGNOSTICS.VIEW"],
          "engineer": ["TEST.RUN", "RECIPE.VIEW", "RECIPE.EDIT", "REPORT.VIEW", "REPORT.EXPORT", "DIAGNOSTICS.VIEW"],
          "operator": ["TEST.RUN", "RECIPE.VIEW", "REPORT.VIEW", "REPORT.EXPORT"],
          "maintenance": ["MAINTENANCE.CALIBRATE", "DIAGNOSTICS.VIEW"]
        },
        "users": [
          { "username": "admin", "password": "admin", "role": "super_admin" }
        ]
      }
    },
    {
      "id": "logs",
      "variant": "db",
      "config": {
        "schema_version": 1,
        "persist": { "min_level": "warning", "subsystems": [] },
        "dedup": { "enabled": true, "window_s": 10 },
        "retention": {
          "error_log":  { "max_days": 90,  "max_records": 500000 },
          "action_log": { "max_days": 365, "max_records": 1000000 }
        },
        "pruning": { "enabled": true, "run_at_hour_utc": 2 }
      }
    },
    {
      "id": "recipe",
      "variant": "filesystem",
      "config": { "schema_version": 1, "root": "data/recipes" }
    },
    {
      "id": "report",
      "variant": "standard",
      "config": {
        "schema_version": 1,
        "sinks": [
          { "type": "sqlite", "when": "all" },
          { "type": "folder", "when": "fail", "path": "data/reports/fail", "format": "csv" },
          { "type": "folder", "when": "pass", "path": "data/reports/pass", "format": "json" }
        ]
      }
    }
  ]
}
