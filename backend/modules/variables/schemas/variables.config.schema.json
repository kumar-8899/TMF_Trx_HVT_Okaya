{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmf:variables:module",
  "title": "variables module configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "library_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Directories added to sys.path so the instrument-library package(s) resolve (e.g. the sibling Instrument_Library repo)."
    },
    "library_packages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Package names imported at load so their @instrument_library decorators fire (e.g. 'instrument_libs')."
    },
    "instances": {
      "type": "array",
      "description": "Python-owned instrument instances (INSTRUMENT_LIBRARY.md §5.2).",
      "items": {
        "type": "object",
        "required": ["id", "library"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "library": { "type": "string", "minLength": 1, "description": "library_id in the instrumentlib index." },
          "params": { "type": "object", "description": "Connection params for the library." },
          "stations": { "type": "array", "items": { "type": "string" },
                        "description": "Sockets this instance serves (MULTI_STATION.md §4.3); absent = all." },
          "simulated": { "type": "boolean", "default": true }
        }
      }
    },
    "variables": {
      "type": "object",
      "description": "name -> binding (INSTRUMENT_LIBRARY.md §5.3). Non-scalar capabilities MUST NOT appear here.",
      "additionalProperties": {
        "type": "object",
        "required": ["instance"],
        "additionalProperties": false,
        "properties": {
          "instance": { "type": "string", "minLength": 1 },
          "read": { "type": "string", "description": "capability read method (e.g. measure_current)." },
          "write": { "type": "string", "description": "capability write method (e.g. set_voltage)." },
          "units": { "type": "string" },
          "scale": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gain": { "type": "number", "default": 1.0 },
              "offset": { "type": "number", "default": 0.0 }
            }
          },
          "clamp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "description": "Expected read range — the denominator for the Debug Server's deadband-% analog logging, and the source of threshold-crossing records (REMOTE_DEBUG.md §4.2). Distinct from `clamp`, which bounds writes.",
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          },
          "deadband": {
            "type": "number",
            "minimum": 0,
            "description": "Per-variable absolute deadband for change-logging (REMOTE_DEBUG.md §4.2). Reserved from day one; left unset in phase 1, when the global debug.analog.default_deadband_pct applies."
          }
        }
      }
    }
  }
}
