{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmf:health/health.config.schema.json",
  "title": "Health Check module config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "data_root": { "type": "string", "description": "Root checked by web.disk_space." },
    "disk_min_gb": { "type": "number", "minimum": 0, "description": "Minimum free GB before web.disk_space fails." },
    "clock_skew_tolerance_s": { "type": "number", "minimum": 0, "description": "Max LabVIEW↔Python skew before bridge.clock_skew fails." },
    "known_issues_dir": { "type": "string", "description": "Deployer dir of known-issue JSON files, overlaid on the shipped catalog." },
    "instances": {
      "type": "array",
      "description": "Hardware instances templated checks expand against (HEALTH §4.4).",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "description": "Human instrument name shown to operators, e.g. 'Digital Multimeter'." },
          "group": { "type": "string", "description": "Business group override (default 'Test Equipment')." },
          "family": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "suites": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } },
      "description": "Named suites -> check id lists. Overrides the shipped defaults (smoke/full)."
    },
    "schedule": {
      "type": "object",
      "description": "Predefined scheduled health runs.",
      "additionalProperties": false,
      "properties": {
        "suite": { "type": "string", "default": "smoke", "description": "Suite the scheduler runs." },
        "startup": { "type": "boolean", "default": false, "description": "Run once shortly after boot." },
        "shutdown": { "type": "boolean", "default": false, "description": "Run once on graceful shutdown." },
        "every_30min": { "type": "boolean", "default": false, "description": "Run every 30 minutes." },
        "daily": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$", "description": "Daily run at local HH:MM (or null)." }
      }
    }
  }
}
