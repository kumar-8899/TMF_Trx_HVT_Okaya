{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmf:auth/auth.config.schema.json",
  "title": "Auth module config",
  "type": "object",
  "required": ["authenticator", "roles"],
  "additionalProperties": true,
  "properties": {
    "authenticator": { "enum": ["password", "no_auth"] },
    "session_ttl_min": { "type": "integer", "minimum": 1 },
    "password_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_length": { "type": "integer", "minimum": 1 },
        "require_mixed_case": { "type": "boolean" },
        "require_digit": { "type": "boolean" },
        "max_age_days": { "type": "integer", "minimum": 0 }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["username", "role"],
        "additionalProperties": false,
        "properties": {
          "username": { "type": "string", "minLength": 1 },
          "password": { "type": "string" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
