{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmf:runs/runs.config.schema.json",
  "title": "Runs module config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "acquisition": {
      "type": "object",
      "additionalProperties": true,
      "description": "How a run learns which recipe to run (runs §run.start).",
      "properties": {
        "default_mode": {
          "enum": ["barcode", "recipe"],
          "description": "Default Start-dialog mode for this bench."
        },
        "barcode": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "strategy": { "type": "string", "description": "Resolver strategy: 'prefix' (first N chars = recipe id) or 'fixed' (barcode is the DUT serial; always run 'recipe_id')." },
            "length": { "type": "integer", "minimum": 1, "description": "Chars taken for the 'prefix' strategy." },
            "recipe_id": { "type": "string", "description": "The recipe run by the 'fixed' strategy (single-product bench scanning a serial)." }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "description": "How Serial No / Model are derived from the barcode.",
      "properties": {
        "model": { "type": "string", "description": "'prefix' = resolved recipe id." },
        "serial": { "type": "string", "description": "'barcode' = the full scanned barcode." }
      }
    },
    "live_variables": {
      "type": "array",
      "description": "Station variables shown continuously in the operator window.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":   { "type": "string", "minLength": 1 },
          "label":  { "type": "string" },
          "unit":   { "type": "string" },
          "format": { "type": "string", "description": "Optional display hint, e.g. '0.0'." }
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "daily": { "type": "boolean" } }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "verdict_banner": { "type": "boolean" },
        "message_line": { "type": "boolean" },
        "today_strip": { "type": "boolean" }
      }
    }
  }
}
