{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmf:report/report.config.schema.json",
  "title": "Report module config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "sinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": true,
        "properties": {
          "type": { "enum": ["sqlite", "folder", "mysql"] },
          "when": { "enum": ["all", "pass", "fail"] },
          "path": { "type": "string" },
          "format": { "enum": ["json", "csv"] }
        }
      }
    }
  }
}
