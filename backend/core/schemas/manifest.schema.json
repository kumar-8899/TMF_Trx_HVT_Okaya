{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmf:core/manifest.schema.json",
  "title": "Module manifest (manifest.json)",
  "description": "CORE.md §3.1 — static self-description shipped with a module.",
  "type": "object",
  "required": ["schema_version", "module", "entitlement_key", "variants"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "module": {
      "type": "object",
      "required": ["id", "version", "contract_version", "display_name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "integer", "minimum": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "entitlement_key": { "type": "string", "minLength": 1 },
    "variants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "core_dependencies": { "type": "array", "items": { "type": "string" } },
    "contract_dependencies": { "type": "array", "items": { "type": "string" } },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_prefix": { "type": "string" },
        "mqtt_subscriptions": { "type": "array", "items": { "type": "string" } },
        "migrations": { "type": ["string", "null"] },
        "frontend_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "config_schema": { "type": ["string", "null"] }
  }
}
