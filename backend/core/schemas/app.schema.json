{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmf:core/app.schema.json",
  "title": "Deployment config (app.json)",
  "description": "CORE.md §3.2 — per-station deployment config.",
  "type": "object",
  "required": ["schema_version", "license", "modules"],
  "additionalProperties": false,
  "anyOf": [
    { "required": ["stations"] },
    { "required": ["station"] }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "stations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "This PC's station ids — one test socket per id (MULTI_STATION.md §1)."
    },
    "station": {
      "type": "string", "minLength": 1,
      "description": "DEPRECATED singular form; read as a one-element `stations` list (MULTI_STATION.md §1)."
    },
    "branding": {
      "type": "object",
      "description": "App identity shown in the UI (TEMPLATE.md §1 — rebrand via config, not source).",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Shell/AppBar + login title." },
        "short": { "type": "string", "maxLength": 2, "description": "Glyph initial(s)." },
        "product": { "type": "string", "description": "Browser tab title." },
        "tagline": { "type": "string", "description": "Login caption." }
      }
    },
    "license": { "type": "string", "minLength": 1 },
    "licensing": {
      "type": "object",
      "description": "Licensing provider selection (SECURE_DISTRIBUTION.md). Default: stub.",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["stub", "keystation"] },
        "core_lib": { "type": "string", "description": "Path to keystation_core.dll (else KEYSTATION_CORE_LIB env)." },
        "product": { "type": "string", "description": "The LICENSED unit's Keystation product slug. Framework repo: super_test_app (dev). A derived customer app sets its own app-track slug (e.g. exeliq.acme_eol)." },
        "runtime": { "enum": ["python_framework", "labview_standalone"], "description": "Keystation runtime discriminator (default python_framework)." },
        "key_map": { "type": "object", "additionalProperties": { "type": "string" },
                     "description": "module[:variant] -> entitlement key overrides; default plugin.<module_id>." }
      }
    },
    "updates": {
      "type": "object",
      "description": "Signed code-update source (SECURE_DISTRIBUTION.md §6).",
      "additionalProperties": false,
      "properties": {
        "github_repo": { "type": "string", "description": "owner/repo whose latest Release carries the .ksupdate asset." },
        "github_token": { "type": "string", "description": "Read token for a private repo (or set TMF_UPDATE_TOKEN env). Omit for public." }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "variant"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "minLength": 1 },
          "config": { "type": "object" }
        }
      }
    }
  }
}
