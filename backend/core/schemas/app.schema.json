{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmf:core/app.schema.json",
  "title": "Deployment config (app.json)",
  "description": "CORE.md §3.2 — per-station deployment config.",
  "type": "object",
  "required": ["schema_version", "station", "license", "modules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "station": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "variant"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "minLength": 1 },
          "config": { "type": "object" }
        }
      }
    }
  }
}
