      "write": "write_digital",
      "args": [
        0
      ],
      "units": "bool"
    },
    "hipot_route_pri_core": {
      "instance": "relay1",
      "write": "write_digital",
      "args": [
        1
      ],
      "units": "bool"
    },
    "hipot_route_sec_core": {
      "instance": "relay1",
      "write": "write_digital",
